classDiagram
    direction TB

    class std {
        +Postman api
        +WaitGroupIO waitgroup
        +BarScanner barscanner
        +PipeFallIO pipefall
        +IBinder systemIO
        +UIfurge uifurge
        +onCreate() std
        +run() std
    }

    class Postman {
        +NetTarget target
        +get()
        +post()
        +probeBreakfastApproval()
    }

    class WaitGroupIO {
        <<interface>>
        +onwaitgroup
        +push(orderCode, approvalState, task)
        +enroll()
        +persist()
        +destroy()
    }

    class WaitGroup {
        -Node current 遍历游标
        -int size
        -long revision
        +push()
        +enroll()
        -insertOrCompact()
        -remove()
    }

    class WaitGroupNode {
        -id
        -orderCode
        -task 登记或取消登记
        -state 0..2
        -createdAtEpochMs
        -Node next
    }

    class WaitGroupTask {
        <<enumeration>>
        Enroll
        CancelEnrollment
    }

    class NetTarget {
        +scheme
        +host
        +port
        +path
    }

    class PostmanAction {
        +ok
        +done
        +msg
        +Do()
    }

    class BarScanner {
        +start()
        +stop()
        +destroy()
    }

    class NewBarScanner {
        +invoke() BarScanner
    }

    class UIfurge {
        +bindUI()
        +render()
    }

    class PipeFallIO {
        <<abstract>>
        +writeEvent()
        +writeCommand()
    }

    class PipeFall {
        +writeEvent()
        +writeCommand()
    }

    class IBinder {
        <<system>>
    }

    std *-- Postman : 封装 api
    std *-- WaitGroupIO : 封装持久化缓冲
    std *-- BarScanner : 封装 scanner
    std *-- UIfurge : 封装 ui
    std *-- PipeFallIO : 封装 pipe
    std o-- IBinder : systemIO

    Postman *-- NetTarget : 封装目标地址
    Postman ..> PostmanAction : 创建一次性动作
    WaitGroup --|> WaitGroupIO : 实现
    WaitGroup *-- WaitGroupNode : 环形链表
    WaitGroupNode --> WaitGroupTask : 任务类型
    WaitGroup ..> Postman : 状态2审批探针

    NewBarScanner ..> BarScanner : 工厂创建

    PipeFall --|> PipeFallIO : 实现抽象
    PipeFallIO --|> IBinder : 可上转型